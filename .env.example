GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile   # optional
DATA_DIR=data/jobs                    # optional

# Recruiter finder — optional, tried in order as fallback
BRAVE_API_KEY=
TAVILY_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Email discovery — optional
HUNTER_API_KEY=
APOLLO_API_KEY=

# Gmail sender
GMAIL_SENDER_NAME=Your Name
GMAIL_MAX_SEND_PER_RUN=3             # emails per batch round (default: 3)
GMAIL_BOUNCE_POLL_INTERVAL_SECONDS=60  # seconds between bounce polls (default: 60)
GMAIL_BOUNCE_LOOKBACK_MINUTES=30     # how far back to search for bounces (default: 30)
